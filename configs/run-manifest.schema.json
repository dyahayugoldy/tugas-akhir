{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Forecast Experiment Run Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_type",
    "config_version",
    "created_at_utc",
    "source_dirty",
    "effective_config",
    "run_id",
    "model_name",
    "seed",
    "data_manifest_id",
    "split_manifest_id",
    "feature_contract_version",
    "source_revision",
    "environment",
    "timing",
    "artifacts"
  ],
  "properties": {
    "schema_version": {"const": "1"},
    "run_type": {"enum": ["dummy", "experiment"]},
    "config_version": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "created_at_utc": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"},
    "source_dirty": {"type": "boolean"},
    "effective_config": {"type": "object", "minProperties": 1},
    "run_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]*$"
    },
    "model_name": {
      "type": "string",
      "enum": ["moebs_transformer", "nspace_transformer", "tft"]
    },
    "seed": {
      "type": "integer",
      "minimum": 0
    },
    "data_manifest_id": {
      "type": "string",
      "minLength": 1
    },
    "split_manifest_id": {
      "type": "string",
      "minLength": 1
    },
    "feature_contract_version": {
      "type": "string",
      "minLength": 1
    },
    "source_revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40,64}$"
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["python_version", "packages", "framework", "framework_version", "device", "hardware"],
      "properties": {
        "python_version": { "type": "string" },
        "framework": { "type": "string" },
        "packages": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "minLength": 1}},
        "framework_version": { "type": ["string", "null"] },
        "device": { "enum": ["cpu", "cuda", "mps"] },
        "hardware": {
          "type": "object", "additionalProperties": false,
          "required": ["os", "architecture", "cpu", "logical_cpu_count", "gpu"],
          "properties": {
            "os": {"type": "string", "minLength": 1},
            "architecture": {"type": "string", "minLength": 1},
            "cpu": {"type": "string", "minLength": 1},
            "logical_cpu_count": {"type": ["integer", "null"], "minimum": 1},
            "gpu": {"type": "array", "items": {"type": "string", "minLength": 1}}
          }
        }
      }
    },
    "timing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["training_seconds", "inference_seconds"],
      "properties": {
        "training_seconds": { "type": "number", "minimum": 0 },
        "inference_seconds": { "type": "number", "minimum": 0 }
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["effective_config", "checkpoint", "predictions", "metrics", "dummy_output"],
      "properties": {
        "effective_config": {"$ref": "#/$defs/artifact_path"},
        "checkpoint": {"anyOf": [{"$ref": "#/$defs/artifact_path"}, {"type": "null"}]},
        "predictions": {"anyOf": [{"$ref": "#/$defs/artifact_path"}, {"type": "null"}]},
        "metrics": {"anyOf": [{"$ref": "#/$defs/artifact_path"}, {"type": "null"}]},
        "dummy_output": {"anyOf": [{"$ref": "#/$defs/artifact_path"}, {"type": "null"}]}
      }
    }
  },
  "$defs": {
    "artifact_path": {"type": "string", "pattern": "^artifacts/runs/[a-z0-9][a-z0-9_-]*/[a-zA-Z0-9_./-]+$"}
  },
  "allOf": [{
    "if": {"properties": {"run_type": {"const": "dummy"}}},
    "then": {"properties": {
      "data_manifest_id": {"const": "synthetic-only"},
      "split_manifest_id": {"const": "synthetic-only"},
      "feature_contract_version": {"const": "synthetic-only"},
      "timing": {"properties": {"training_seconds": {"const": 0}, "inference_seconds": {"const": 0}}},
      "artifacts": {"properties": {"checkpoint": {"type": "null"}, "predictions": {"type": "null"}, "metrics": {"type": "null"}, "dummy_output": {"$ref": "#/$defs/artifact_path"}}}
    }},
    "else": {"properties": {"artifacts": {"properties": {
      "checkpoint": {"$ref": "#/$defs/artifact_path"},
      "predictions": {"$ref": "#/$defs/artifact_path"},
      "metrics": {"$ref": "#/$defs/artifact_path"},
      "dummy_output": {"type": "null"}
    }}}}
  }]
}
