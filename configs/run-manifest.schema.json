{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Forecast Experiment Run Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_type",
    "config_version",
    "created_at_utc",
    "source_dirty",
    "effective_config",
    "run_id",
    "model_name",
    "seed",
    "data_manifest_id",
    "split_manifest_id",
    "feature_contract_version",
    "source_revision",
    "environment",
    "timing",
    "artifacts"
  ],
  "properties": {
    "schema_version": {"const": "1"},
    "run_type": {"enum": ["dummy", "acceptance", "experiment"]},
    "wp5": {"type": "object"},
    "wp6": {"type": "object"},
    "wp7": {"type": "object"},
    "config_version": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "created_at_utc": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"},
    "source_dirty": {"type": "boolean"},
    "effective_config": {"type": "object", "minProperties": 1},
    "run_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]*$"
    },
    "model_name": {
      "type": "string",
      "enum": ["moebs_transformer", "nspace_transformer", "tft"]
    },
    "seed": {
      "type": "integer",
      "minimum": 0
    },
    "data_manifest_id": {
      "type": "string",
      "minLength": 1
    },
    "split_manifest_id": {
      "type": "string",
      "minLength": 1
    },
    "feature_contract_version": {
      "type": "string",
      "minLength": 1
    },
    "source_revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40,64}$"
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["python_version", "packages", "framework", "framework_version", "device", "hardware"],
      "properties": {
        "python_version": { "type": "string" },
        "framework": { "type": "string" },
        "packages": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "minLength": 1}},
        "framework_version": { "type": ["string", "null"] },
        "device": { "enum": ["cpu", "cuda", "mps"] },
        "hardware": {
          "type": "object", "additionalProperties": false,
          "required": ["os", "architecture", "cpu", "logical_cpu_count", "gpu"],
          "properties": {
            "os": {"type": "string", "minLength": 1},
            "architecture": {"type": "string", "minLength": 1},
            "cpu": {"type": "string", "minLength": 1},
            "logical_cpu_count": {"type": ["integer", "null"], "minimum": 1},
            "gpu": {"type": "array", "items": {"type": "string", "minLength": 1}}
          }
        }
      }
    },
    "timing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["training_seconds", "inference_seconds"],
      "properties": {
        "training_seconds": { "type": "number", "minimum": 0 },
        "inference_seconds": { "type": "number", "minimum": 0 }
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["effective_config", "checkpoint", "predictions", "metrics", "dummy_output"],
      "properties": {
        "effective_config": {"$ref": "#/$defs/artifact_path"},
        "checkpoint": {"anyOf": [{"$ref": "#/$defs/artifact_path"}, {"type": "null"}]},
        "predictions": {"anyOf": [{"$ref": "#/$defs/artifact_path"}, {"type": "null"}]},
        "metrics": {"anyOf": [{"$ref": "#/$defs/artifact_path"}, {"type": "null"}]},
        "dummy_output": {"anyOf": [{"$ref": "#/$defs/artifact_path"}, {"type": "null"}]}
      }
    }
  },
  "$defs": {
    "artifact_path": {"type": "string", "pattern": "^artifacts/runs/[a-z0-9][a-z0-9_-]*/[a-zA-Z0-9_./-]+$"}
  },
  "allOf": [{
    "if": {"properties": {"run_type": {"const": "dummy"}}},
    "then": {"properties": {
      "data_manifest_id": {"const": "synthetic-only"},
      "split_manifest_id": {"const": "synthetic-only"},
      "feature_contract_version": {"const": "synthetic-only"},
      "timing": {"properties": {"training_seconds": {"const": 0}, "inference_seconds": {"const": 0}}},
      "artifacts": {"properties": {"checkpoint": {"type": "null"}, "predictions": {"type": "null"}, "metrics": {"type": "null"}, "dummy_output": {"$ref": "#/$defs/artifact_path"}}}
    }},
    "else": {"properties": {"artifacts": {"properties": {
      "checkpoint": {"$ref": "#/$defs/artifact_path"},
      "predictions": {"$ref": "#/$defs/artifact_path"},
      "metrics": {"$ref": "#/$defs/artifact_path"},
      "dummy_output": {"type": "null"}
    }}}}
  }, {
    "if": {"properties": {"run_type": {"const": "acceptance"}}},
    "then": {"required": ["wp5"], "properties": {"wp5": {
      "required": ["purpose", "verification", "source_code_sha256", "split_manifest_sha256", "checksums"],
      "properties": {"purpose": {"const": "WP5_acceptance_not_final_comparison"}}
    }}}
  }, {
    "if": {"properties": {"run_type": {"const": "experiment"}}},
    "then": {"oneOf": [{"required": ["wp6"], "not": {"required": ["wp7"]}}, {"required": ["wp7"], "not": {"required": ["wp6"]}}], "properties": {"wp6": {
      "type": "object",
      "additionalProperties": false,
      "required": ["purpose", "phase", "verification", "source_code_sha256", "split_manifest_sha256", "checksums", "privacy", "availability_assumption", "coverage_assumption"],
      "properties": {
        "purpose": {"const": "WP6_fair_training_protocol"},
        "phase": {"enum": ["tuning", "final_training"]},
        "verification": {"type": "object"},
        "source_code_sha256": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
        "split_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "checksums": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
        "privacy": {"const": "private_no_raw_business_identifiers_in_logs"},
        "availability_assumption": {},
        "coverage_assumption": {},
        "data_digests": {"type": "object"},
        "training": {"type": "object"},
        "search": {"type": "object"},
        "selected_trial_id": {"type": ["integer", "null"], "minimum": 0},
        "search_seconds": {"type": "number", "minimum": 0},
        "total_trial_training_seconds": {"type": "number", "minimum": 0},
        "completed_trials": {"type": "integer", "minimum": 0},
        "fresh_initialization": {"type": "boolean"},
        "tuning": {"type": "object"},
        "inference_benchmark": {"type": "object"},
        "memory": {"type": "object"}
      }
    }}}
  }, {
    "if": {"required": ["wp7"]},
    "then": {"properties": {"run_type": {"const": "experiment"}, "wp7": {
      "type": "object", "additionalProperties": false,
      "required": ["purpose", "cohort_sha256", "split_manifest_sha256", "test_digest", "checkpoint_sha256", "upstream_training_seconds", "parameter_count", "inference_benchmark", "test_used_for_fitting_or_selection", "prediction_policy", "coverage_assumption", "availability_assumption", "source_code_sha256", "checksums", "privacy"],
      "properties": {
        "purpose": {"const": "WP7_frozen_test_evaluation"},
        "cohort_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "split_manifest_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "test_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "checkpoint_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "upstream_training_seconds": {"type": "number", "minimum": 0},
        "parameter_count": {"type": "integer", "minimum": 1},
        "inference_benchmark": {"type": "object"},
        "test_used_for_fitting_or_selection": {"const": false},
        "prediction_policy": {"const": "original_pcs_unclipped_no_rounding"},
        "coverage_assumption": {}, "availability_assumption": {},
        "source_code_sha256": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "pattern": "^[a-f0-9]{64}$"}},
        "checksums": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "pattern": "^[a-f0-9]{64}$"}},
        "privacy": {"const": "private_no_raw_business_identifiers_in_logs"}
      }
    }}}
  }]
}
