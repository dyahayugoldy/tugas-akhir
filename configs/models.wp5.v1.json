{
  "config_version": "models-wp5-v1",
  "purpose": "WP5_acceptance_not_final_comparison",
  "current_data_pointer": "configs/current-data.json",
  "output_root": "artifacts/runs",
  "seed": 42,
  "runtime": {"device": "cpu", "precision": "float32", "threads": 2, "deterministic": true},
  "training": {
    "batch_size": 256, "max_epochs": 1, "patience": 1, "min_delta": 0.0,
    "learning_rate": 0.001, "weight_decay": 0.0001, "gradient_clip": 1.0,
    "optimizer": "adamw", "loss": "mse", "shuffle": true,
    "max_seconds": 180, "checkpoint_selection": "validation_rmse"
  },
  "metrics": {"smape_epsilon": 0.000001, "constant_r2": "null", "mape": "actual_nonzero_only"},
  "models": {
    "moebs_transformer": {"d_model": 32, "n_heads": 2, "encoder_layers": 2, "decoder_layers": 2, "d_ff": 64, "dropout": 0.1, "embedding_dim": 4, "position_base": 10000.0},
    "nspace_transformer": {"d_model": 32, "n_heads": 2, "encoder_layers": 2, "decoder_layers": 2, "d_ff": 64, "dropout": 0.1, "embedding_dim": 4, "position_base": 10000.0},
    "tft": {"d_model": 32, "n_heads": 2, "lstm_layers": 1, "dropout": 0.1, "embedding_dim": 4}
  },
  "search": {
    "objective_names": ["validation_rmse", "validation_mae", "parameter_count"],
    "selection": "lexicographic_validation_rmse_mae_parameter_count_trial_id",
    "max_evaluations": 4, "max_seconds": 900,
    "space": {"d_model": {"type": "choice", "values": [32, 64]}, "n_heads": {"type": "choice", "values": [1, 2, 4]}, "learning_rate": {"type": "log_float", "low": 0.0003, "high": 0.003}, "weight_decay": {"type": "log_float", "low": 0.000001, "high": 0.001}},
    "moebs": {"population_size": 2, "max_iterations": 1, "archive_size": 8, "grid_bins": 5, "epsilon": 1e-12, "beta_values": [0, 2]},
    "other_models": "random_search_same_evaluations_epochs_and_wall_clock_caps"
  },
  "wp6_recommendation": {"seeds": [42, 123, 2026], "status": "proposal_requires_WP6_resource_calibration", "validation_calendar_weeks": 9, "do_not_expand_search_using_test": true},
  "adaptations": "docs/wp5-models.md"
}
